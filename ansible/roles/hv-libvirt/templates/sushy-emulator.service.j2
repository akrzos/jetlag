[Unit]
Description=Sushy Libvirt emulator
After=syslog.target

[Service]
Type=simple
Environment="SUSHY_EMULATOR_CONFIG=/etc/sushy-emulator/sushy-emulator.conf"
ExecStart=/usr/local/bin/gunicorn \
    --workers {{ sushy_emulator_workers }} \
    --bind [::]:{{ hypervisor_bmc_port }} \
    --timeout {{ sushy_emulator_timeout }} \
    --access-logfile - \
    --error-logfile - \
    sushy_tools.emulator.main:app
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
